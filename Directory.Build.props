<Project>
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.props.user" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.props.user')" />
  <PropertyGroup>
    <AlwaysUseLibsDir Condition="'$(AlwaysUseLibsDir)' == ''">false</AlwaysUseLibsDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AlwaysUseLibsDir)' == 'true' And '$(LibsDir)' != ''">
    <ManagedDir>$(LibsDir)</ManagedDir>
    <BepInExDir>$(LibsDir)</BepInExDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AlwaysUseLibsDir)' != 'true' And '$(ValheimDir)' != ''">
    <ManagedDir>$(ValheimDir)\valheim_Data\Managed\</ManagedDir>
    <BepInExDir>$(ValheimDir)\BepInEx\core\</BepInExDir>
  </PropertyGroup>
  <Target Name="CheckLibsDir" BeforeTargets="ResolveAssemblyReferences;CoreCompile">
    <ItemGroup>
      <_UserFileLine Include="&lt;Project&gt;" />
      <_UserFileLine Include="  &lt;PropertyGroup&gt;" />
      <_UserFileLine Include="    &lt;ValheimDir&gt;C:\YOUR_PATH\steamapps\common\Valheim&lt;/ValheimDir&gt;" />
      <_UserFileLine Include="    &lt;LibsDir&gt;C:\YOUR_PATH\Libs\&lt;/LibsDir&gt;" />
      <_UserFileLine Include="    &lt;AlwaysUseLibsDir&gt;false&lt;/AlwaysUseLibsDir&gt;" />
      <_UserFileLine Include="  &lt;/PropertyGroup&gt;" />
      <_UserFileLine Include="&lt;/Project&gt;" />
    </ItemGroup>
    <PropertyGroup>
      <_MissingDirs Condition="'$(LibsDir)' == '' Or ('$(AlwaysUseLibsDir)' != 'true' And '$(ValheimDir)' == '')">true</_MissingDirs>
    </PropertyGroup>
    <WriteLinesToFile Condition="'$(_MissingDirs)' == 'true' And !Exists('$(MSBuildThisFileDirectory)Directory.Build.props.user')" File="$(MSBuildThisFileDirectory)Directory.Build.props.user" Lines="@(_UserFileLine)" />
    <Error Condition="'$(_MissingDirs)' == 'true'" Text="Failed to read Directory.Build.props.user. Remove the existing file and build to regenerate it." />
    <Error Condition="'$(_MissingDirs)' != 'true' And !Exists('$(ManagedDir)assembly_valheim.dll')" Text="assembly_valheim.dll not found in '$(ManagedDir)'. Update file paths in Directory.Build.props.user." />
    <Error Condition="'$(_MissingDirs)' != 'true' And !Exists('$(BepInExDir)BepInEx.dll')" Text="BepInEx.dll not found in '$(BepInExDir)'. Install BepInEx or update file paths in Directory.Build.props.user." />
  </Target>
</Project>
