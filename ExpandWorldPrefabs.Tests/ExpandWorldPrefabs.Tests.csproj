<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Unity's netstandard2.1 assemblies use default interface methods, which net48 can't load. -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <!-- NU1702: referencing the net48 mod project. SYSLIB0050: FormatterServices for uninitialized game objects. -->
    <NoWarn>$(NoWarn);NU1702;SYSLIB0050</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
    <!-- Required by BepInEx.Paths during NUnit fixture initialization. -->
    <PackageReference Include="MonoMod.Utils" Version="22.1.29.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ManagedDir)assembly_utils.dll</HintPath>
    </Reference>
    <Reference Include="assembly_valheim" Publicize="true">
      <HintPath>$(ManagedDir)assembly_valheim.dll</HintPath>
    </Reference>
    <Reference Include="YamlDotNet">
      <HintPath>$(LibsDir)YamlDotNet.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)0Harmony.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExpandWorldPrefabs\ExpandWorldPrefabs.csproj" />
  </ItemGroup>
</Project>
